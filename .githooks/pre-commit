#!/usr/bin/env bash
# artbypriti gates — installed by `make setup` (git config core.hooksPath .githooks)
#
# Fast gates only. Reads staged content, runs no build, so committing stays
# near-instant: a slow pre-commit hook gets bypassed habitually, which is worse
# than no hook at all.
#
#   hygiene -> secrets, committing on main, non-determinism, stray binaries
#   specs   -> is every spec real, or still a template?
#
# Bypass: git commit --no-verify
set -e
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-hygiene.sh"
python3 "$root/scripts/check-constitution.py"
python3 "$root/scripts/check-specs.py"
